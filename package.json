{
	"name": "telegram-scraper",
	"version": "1.0.0",
	"description": "A Puppeteer-based Telegram channel scraper with translation support.",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"scripts": {
		"chrome": "bunx puppeteer browsers install chrome",
		"dev": "bun run format && bun src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"format": "bunx biome format --write",
		"lint": "bunx biome lint --write"
	},
	"keywords": [
		"telegram",
		"scraper",
		"puppeteer",
		"typescript",
		"crawler"
	],
	"author": "Saeed Kefayati",
	"license": "AGPL-3.0",
	"files": [
		"dist"
	],
	"dependencies": {
		"@vitalets/google-translate-api": "^9.2.1",
		"puppeteer": "^24.30.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.7",
		"@types/node": "^24.10.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3"
	}
}
